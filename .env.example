# Copy to .env (in your footage folder or this repo). Never commit .env.
# Stock B-roll (any of these; tried in the order of `stock:` in the batch)
COVERR_API_KEY=          # free, instant: https://coverr.co/developers (marks AI clips; reel skips them)
PEXELS_API_KEY=          # new keys paused by Pexels; an existing key works
PIXABAY_API_KEY=         # free, instant: https://pixabay.com/api/docs/ (backup: can't filter AI uploads)
# Optional
# OPENAI_API_KEY=          # reel ingest --backend openai, instead of local faster-whisper
# REEL_WHISPER_MODEL=small.en
# REEL_TOKEN=              # require this bearer token on the web API when hosting it
