# Copy to .env (in this repo or your footage folder). Never commit .env.
# Stock B-roll: a Pixabay key is built in. Set your own here to override it, or "off" to turn Pixabay off.
# PIXABAY_API_KEY=
# Optional
# PEXELS_API_KEY=          # an existing Pexels key is tried before Pixabay (new keys are paused)
# OPENAI_API_KEY=          # reel ingest --backend openai, instead of local faster-whisper
# REEL_WHISPER_MODEL=small.en
# REEL_TOKEN=              # require this bearer token on the web API when hosting it
