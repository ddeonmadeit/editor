# Copy to .env (in your footage folder or this repo). Never commit .env.
# Optional: fills B-roll gaps automatically. Without it, missing clips are listed with
# Pexels links for a person to download. (Pexels has paused new keys; an existing one works.)
PEXELS_API_KEY=
# Optional
# PIXABAY_API_KEY=         # only used when a batch sets stock: [pexels, pixabay] (Pixabay can't filter AI uploads)
# OPENAI_API_KEY=          # reel ingest --backend openai, instead of local faster-whisper
# REEL_WHISPER_MODEL=small.en
# REEL_TOKEN=              # require this bearer token on the web API when hosting it
